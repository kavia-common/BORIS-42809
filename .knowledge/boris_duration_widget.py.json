{"is_source_file": true, "format": "Python", "description": "This file defines a PySide6-based graphical widget for editing durations, supporting formats HH:MM:SS:MS and seconds. It provides two main components: a widget for hours, minutes, seconds, milliseconds (Widget_hhmmss), a widget for seconds with decimal precision (Widget_seconds), and a container widget (Duration_widget) that switches between these formats. The widget emits signals when the time value changes and allows setting and retrieving the current duration.", "external_files": ["config as cfg"], "external_methods": ["Signal (from PySide6.QtCore)"], "published": ["Duration_widget"], "classes": [{"name": "Widget_hhmmss", "description": "A widget for inputting duration in hours, minutes, seconds, and milliseconds, with sign control."}, {"name": "Widget_seconds", "description": "A widget for inputting duration in seconds with decimal precision."}, {"name": "Duration_widget", "description": "A container widget allowing switching between HH:MM:SS:MS and seconds formats for duration input."}], "methods": [{"name": "time_changed(self, x)", "description": "Signal handler called when the time value changes in sub-widgets.", "scope": "Duration_widget", "scopeKind": "class"}, {"name": "set_time(self, new_time)", "description": "Sets the widget's display to a specific duration in seconds.", "scope": "Duration_widget", "scopeKind": "class"}, {"name": "set_format_s(self)", "description": "Switches the display to seconds format.", "scope": "Duration_widget", "scopeKind": "class"}, {"name": "set_format_hhmmss(self)", "description": "Switches the display to HH:MM:SS:MS format.", "scope": "Duration_widget", "scopeKind": "class"}, {"name": "set_format(self, time_format)", "description": "Sets the time display format based on provided configuration constants.", "scope": "Duration_widget", "scopeKind": "class"}, {"name": "dec get_time(self)", "description": "Returns the current duration value in seconds as a Decimal.", "s